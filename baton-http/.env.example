# Copy to .env and edit to taste. .env is gitignored.

# Bearer token Symphony's bearer-auth plug expects. Default value
# matches the seeded api_keys.hashed_secret for the baton_connector
# service identity.
SYMPHONY_API_TOKEN=demo-secret

# Path to the connector config (relative to this dir).
CONFIG_PATH=symphony.yaml

# Path to the baton-http binary. `baton-http` (on PATH) is the default;
# point at a local build for development.
# BATON_HTTP=../../baton-http/baton-http

# --- Service mode (optional) ---
# Set both to stream sync results into a ConductorOne tenant. Leave
# unset for local-sync mode (writes a .c1z file).
# C1_CLIENT_ID=
# C1_CLIENT_SECRET=
